---
import '../styles/global.css';
import ReaderApp from '../components/ReaderApp';
import { books } from '../data/books';
---

<!doctype html>
<html lang="zh-CN" data-theme="ivory">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EvenBetterReads</title>
    <meta
      name="description"
      content="EvenBetterReads — 阿尔贝·加缪《西西弗神话》与弗里德里希·尼采《论道德的谱系》精译伴读"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..600;1,400..600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/LXGWNeoZhiSong-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/LXGWWenKai-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <ReaderApp books={books} client:load />
  </body>
</html>
