---
import '../styles/global.css';
import ReaderApp from '../components/ReaderApp';
---

<!doctype html>
<html lang="zh-CN" data-theme="ivory">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>EvenBetterReads</title>
    <script is:inline>
      try {
        var saved = localStorage.getItem('ebr-theme');
        if (saved === 'ivory' || saved === 'parchment' || saved === 'obsidian') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    </script>
    <meta
      name="description"
      content="EvenBetterReads — 私人思想与哲学经典精译及深度伴读文库"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..600;1,400..600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/fonts/LXGWNeoZhiSong-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/LXGWWenKai-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <ReaderApp client:load />
  </body>
</html>
